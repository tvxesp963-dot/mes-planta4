{
  "hosting": [
    {
      "target": "mes",
      "public": "public",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "*.log",
        "*.cache",
        "index_backup*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "mes-p3",
      "public": "public-p3",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "*.log",
        "*.cache"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "mes-p1",
      "public": "public-p1",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "*.log",
        "*.cache"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
